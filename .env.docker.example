# Stage M Compose secrets. Copy to .env.docker, or let scripts\demo.ps1
# generate a fresh file. Never commit .env.docker.
POSTGRES_USER=adapter
POSTGRES_DB=ai_adapter
# Use a URL-safe random value; scripts\demo.ps1 generates 32 random bytes.
POSTGRES_PASSWORD=replace-with-url-safe-random-value
# User and admin API keys: 16-512 characters, no whitespace, not equal.
SECURITY_API_KEYS=replace-with-user-api-key
SECURITY_ADMIN_API_KEYS=replace-with-admin-api-key
