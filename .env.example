# AI Adapter environment settings.
# Copy this file to .env and adjust values for your environment.

APP_NAME=AI Adapter
ENVIRONMENT=development
DEBUG=false

API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1

LOG_LEVEL=INFO
LOG_FORMAT=json
REQUEST_ID_HEADER=X-Request-ID

CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Stage B provider configuration
DEFAULT_PROVIDER=fake
FAKE_PROVIDER_MODELS=fake-small,fake-large
FAKE_PROVIDER_DEFAULT_MODEL=fake-small

# Stage C OpenAI configuration
# Leave OPENAI_API_KEY blank to keep the OpenAI provider disabled.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELS=gpt-4o-mini,gpt-4o
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30

# Stage D reliability configuration
# Total provider attempts per request; work is bounded by
# RELIABILITY_MAX_ATTEMPTS x (primary + secondary + fallback).
RELIABILITY_MAX_ATTEMPTS=3
RELIABILITY_BACKOFF_BASE_SECONDS=0.25
RELIABILITY_BACKOFF_MAX_SECONDS=2.0
RELIABILITY_JITTER_SECONDS=0.1
RELIABILITY_TIMEOUT_SECONDS=35
RELIABILITY_CIRCUIT_FAILURE_THRESHOLD=3
RELIABILITY_CIRCUIT_RECOVERY_SECONDS=30
# Optional provider tried after the selected provider fails (blank = disabled).
RELIABILITY_SECONDARY_PROVIDER=
# Deterministic local fallback (blank = disabled).
RELIABILITY_FALLBACK_PROVIDER=fake

# Stage E security configuration
# Keep credentials out of source control; inject them through the environment.
# SECURITY_REQUIRE_AUTH is forced on when ENVIRONMENT=production.
SECURITY_REQUIRE_AUTH=false
# Comma-separated bearer keys. Each key: 16-512 characters, no whitespace.
SECURITY_API_KEYS=
# Additional keys allowed to call administrative provider endpoints.
SECURITY_ADMIN_API_KEYS=
# Fixed-window request limit per identity or client address (0 disables).
SECURITY_RATE_LIMIT_REQUESTS=60
SECURITY_RATE_LIMIT_WINDOW_SECONDS=60

# Stage E budget configuration (USD as decimal strings)
BUDGET_ENFORCEMENT_ENABLED=true
BUDGET_PER_REQUEST_USD=0.25
BUDGET_DAILY_USD=50
BUDGET_MONTHLY_USD=500
# Completion tokens assumed for the pre-call reservation when max_tokens is absent.
BUDGET_ASSUMED_COMPLETION_TOKENS=512
# JSON object mapping provider name to USD per million tokens.
BUDGET_PROVIDER_PRICING={"fake": {"input_per_million_usd": 0, "output_per_million_usd": 0}, "openai": {"input_per_million_usd": 0.15, "output_per_million_usd": 0.60}}

# Stage F fault-report summarization
# Completion-token ceiling requested from the AI provider for one summary.
FAULT_REPORT_MAX_TOKENS=512

# Stage G database persistence
# SQLite is used locally; PostgreSQL is required in production.
DATABASE_ENABLED=true
DATABASE_URL=sqlite+aiosqlite:///./data/ai_adapter.db
DATABASE_ECHO=false
DATABASE_AUTO_CREATE=true
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_WRITE_TIMEOUT_SECONDS=2
# Production example (keep the password out of source control):
# DATABASE_URL=postgresql+asyncpg://adapter_user:CHANGE_ME@db-host:5432/ai_adapter
# DATABASE_AUTO_CREATE=false
# Apply schema changes with: .\.venv\Scripts\alembic.exe upgrade head

# Stage I model version management
# JSON manifest used to validate configured provider models and track releases.
# Leave blank to disable the catalog and its administrative endpoint.
MODEL_VERSION_MANIFEST=config/model_versions.json

# Stage K cost and latency monitoring
# Durable summaries require DATABASE_ENABLED=true. Prometheus metrics remain
# available for the lifetime of the process even when persistence is disabled.
MONITORING_QUERY_TIMEOUT_SECONDS=5
# Rows sampled for p50/p95 latency; full-window averages come from SQL.
MONITORING_LATENCY_SAMPLE_LIMIT=10000

# Stage L Streamlit dashboard (separate process; read-only)
# The dashboard talks to the API over HTTP. Keep the API bound to loopback
# unless the dashboard connection is protected by TLS.
DASHBOARD_API_BASE_URL=http://127.0.0.1:8000
DASHBOARD_API_PREFIX=/api/v1
# Optional admin key for the API. If blank, enter it in the dashboard sidebar;
# it is held in session memory only and is never written by the dashboard.
DASHBOARD_ADMIN_API_KEY=
DASHBOARD_REQUEST_TIMEOUT_SECONDS=10
# Set true only when outbound proxy environment variables should be honored.
DASHBOARD_TRUST_ENV=false
